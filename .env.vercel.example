# 100XU on Vercel: copy each KEY and its VALUE into
# Vercel Dashboard -> Project -> Settings -> Environment Variables.
# Leave "Environment" ticked for Production (and Preview if you test PRs).
# Lines with <...> need YOUR values - sources noted after each key.
# Replace every gymfreek.vercel.app with YOUR real Vercel URL.

# --- Database (Neon, pooled - pooling is mandatory on serverless) ---
# Source: Neon dashboard -> your project -> Connection string (pooled).
# Use sslmode=verify-full (Neon default sslmode=require is deprecated by pg).
DATABASE_URL=

# --- Auth ---
# Source: run once locally: openssl rand -base64 48
JWT_SECRET=
# Source: your login email for the first admin account.
ADMIN_EMAILS=abhinavpadige06@gmail.com
NEXTAUTH_URL=https://gymfreek.vercel.app

# --- AI coach: OpenRouter primary, Groq fallback (both free-tier) ---
LLM_PROVIDER=openrouter
# Source: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_APP_NAME=100XU
OPENROUTER_APP_URL=https://gymfreek.vercel.app
# Source: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Challenge + payments (Razorpay TEST mode) ---
# Source: Razorpay Dashboard -> Test Mode -> API keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Source: Razorpay Dashboard -> Test Mode -> Settings -> Webhooks (add
# https://gymfreek.vercel.app/api/payments/webhook, select payment.captured
# and payment.failed, copy the secret).
RAZORPAY_WEBHOOK_SECRET=
# Public by design: same value as RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Demo order activation without keys. MUST stay false in production.
ALLOW_DEMO_PAYMENTS=false

# --- FastAPI AI service (fill after Railway deploy; empty = client-only AI) ---
# Source: Railway service public URL, e.g. https://gymfreek-ai.up.railway.app
AI_SERVICE_URL=
# Source: invent one random string, paste the SAME value in Railway.
AI_SERVICE_TOKEN=
