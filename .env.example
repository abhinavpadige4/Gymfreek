# ============================================================
# 100XU - Environment variables
# ============================================================
# Copy this file to .env and fill in the values.
# .env is ignored by git (see .gitignore).

# --- Database ---
# Managed Postgres (Neon pooled URL) for dev, test, and prod. Use a Neon
# branch for the test database.
DATABASE_URL=postgresql://gymfreek:gymfreek_dev_pwd@localhost:5433/gymfreek

# --- Authentication ---
# Generate 64 random chars: openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48

# Demo account created by the seed (password is hashed at seed time)
USER_EMAIL=you@example.com
USER_PASSWORD=change-me-immediately

# Public demo mode: when "true", the login page shows the demo credentials below
# with a one-click "Log in as demo" button. Leave unset for normal instances.
# These are NEXT_PUBLIC_* (exposed to the browser) so only use them on a public
# demo instance with throwaway credentials.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=demo@gymfreek.app
NEXT_PUBLIC_DEMO_PASSWORD=gymfreekdemo

# --- AI coach ---
# Structured workout summaries go to the separate FastAPI service
# (Gymfreek-ai repo) over HTTPS + bearer token. Empty = client-only mode
# (on-device counting still works, AI coaching shows as unavailable).
# The service receives numbers only - never names, emails, video, or payments.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

# --- Challenges + payments (Razorpay test mode first) ---
# Paste keys here when ready. App runs without them (demo orders, no activation).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Allow demo payment activation outside production before keys are pasted.
ALLOW_DEMO_PAYMENTS=true
# Comma-separated admin emails (first-admin fallback before role is set).
ADMIN_EMAILS=

# --- Legal pages (shown on /terms /privacy /refunds /support) ---
# Fill these in; unset values render as explicit [PLACEHOLDERS]. The demo
# refund text below is an example - replace it with the real policy.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_SUPPORT_PHONE=
NEXT_PUBLIC_LEGAL_SUPPORT_HOURS=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_GOVERNING_LAW=
NEXT_PUBLIC_LEGAL_REFUND_POLICY=Full refund if requested within 7 days of payment, processed to the original payment method within 5-7 working days.

# --- App ---
NEXTAUTH_URL=http://localhost:3030
# Session cookies are Secure by default in production. Set this to "false"
# only when self-hosting over plain HTTP on a trusted network.
# SESSION_COOKIE_SECURE=false
# Public HTTPS origin used when generating ChatGPT connector URLs.
# Set this when NEXTAUTH_URL points to a LAN address behind a reverse proxy.
MCP_PUBLIC_URL=
# Optional MCP endpoint hardening (issue #287). Comma-separated exact-match
# allowlists; setting either enables DNS rebinding protection on the MCP
# transport. CORS keys off MCP_ALLOWED_ORIGINS alone: when it is set, CORS
# echoes only allowlisted origins instead of *; hosts-only keeps CORS at *.
# MCP_ALLOWED_ORIGINS=https://gym.example.com
# MCP_ALLOWED_HOSTS=gym.example.com,gym.example.com:3030
NODE_ENV=development
